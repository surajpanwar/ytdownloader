# Local development variables for the backend.

# Comma-separated list of allowed frontend origins. Add your Vercel domain
# before deploying, e.g. https://my-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# Download timeout in seconds (default 300 = 5 minutes).
YTDL_TIMEOUT_SECONDS=300

# Delete downloaded files older than this many seconds (default 1800 = 30 min).
YTDL_FILE_MAX_AGE_SECONDS=1800

# Where files are stored. Leave as-is for Render; use a real path locally.
YTDL_DOWNLOAD_DIR=